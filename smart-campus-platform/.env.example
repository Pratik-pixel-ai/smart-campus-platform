# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/smartcampus
DATABASE_USERNAME=smartcampus
DATABASE_PASSWORD=smartcampus

# Used by docker-compose to create the database container
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus

# ---- Security ----
# At least 32 characters. If left empty a random key is generated on every start-up,
# which means tokens stop working after a restart.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# ---- Frontend origins allowed to call the API ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Attendance ----
# demo = simulated detection (no hardware). ble = real BLE scans.
ATTENDANCE_MODE=demo

# ---- Demo data ----
SEED_ENABLED=true

# ---- AI assistant (Groq) ----
# Leave empty to run without the assistant; the app still starts and says it is not configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api
